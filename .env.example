# Copy to .env if you want to override docker-compose defaults.
# Never commit a real .env. The compose file already runs with no key.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgresql://ticketdesk:ticketdesk@db:5432/ticketdesk
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# OpenAI-compatible chat completions. Leave the key empty to use keyword triage.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=20
